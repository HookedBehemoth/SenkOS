Subject: [PATCH] Don't draw frames the frontend won't show

GET_AUDIO_VIDEO_ENABLE without video (corehost's fast forward: all frames
of a present but the last): one frame of mGBA's own frameskip, no
scanlines drawn and no finishFrame. Only the renderer is skipped; what the
game sees (VCOUNT, DISPSTAT, IRQs, DMA) runs as before.

Upstream-Status: Pending
---
--- a/src/platform/libretro/libretro.c	2026-10-20 23:04:51.262931968 +0200
+++ b/src/platform/libretro/libretro.c	2026-10-20 23:04:51.389922996 +0200
@@ -1669,6 +1669,24 @@
       updateAudioLatency = false;
    }
 
+	/* A frame the frontend won't show (fast forward): not drawn, as the frameskip above does it */
+	int avEnable = 3;
+	if (environCallback(RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE, &avEnable) && !(avEnable & 1)) {
+		switch (core->platform(core)) {
+#ifdef M_CORE_GBA
+		case mPLATFORM_GBA:
+			((struct GBA*) core->board)->video.frameskipCounter = 1;
+			break;
+#endif
+#ifdef M_CORE_GB
+		case mPLATFORM_GB:
+			((struct GB*) core->board)->video.frameskipCounter = 1;
+			break;
+#endif
+		default:
+			break;
+		}
+	}
 	core->runFrame(core);
 	unsigned width, height;
 	core->currentVideoSize(core, &width, &height);
