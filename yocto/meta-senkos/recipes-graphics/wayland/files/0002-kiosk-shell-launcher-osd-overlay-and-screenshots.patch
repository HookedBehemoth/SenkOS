From: SenkOS
Subject: [PATCH] kiosk-shell: launcher OSD overlay, screenshots for every client

The launcher's windows titled "osd" (top centre) and "perf ..." (the
performance overlay, in the corner the rest of its title names: "perf
bottom-right"), app_id "launcher", keep their own size in a layer above
every surface tree and never take focus. Any client may use
weston_capture_v1: the launcher's pause screen captures the app it covers.

Upstream-Status: Inappropriate [device policy]
---
--- a/kiosk-shell/kiosk-shell.c
+++ b/kiosk-shell/kiosk-shell.c
@@ -833,6 +833,19 @@
  * libweston-desktop
  */
 
+/* The launcher's on-screen display: above every surface tree, at its own size,
+ * never focused, so the app under it keeps running and keeps the keyboard. */
+static bool
+is_overlay(struct weston_desktop_surface *desktop_surface)
+{
+	const char *app_id = weston_desktop_surface_get_app_id(desktop_surface);
+	const char *title = weston_desktop_surface_get_title(desktop_surface);
+
+	return app_id && title &&
+	       strcmp(app_id, "launcher") == 0 &&
+	       (strcmp(title, "osd") == 0 || strncmp(title, "perf", 4) == 0);
+}
+
 static void
 desktop_surface_added(struct weston_desktop_surface *desktop_surface,
 		      void *data)
@@ -847,6 +860,14 @@
 		return;
 
 	weston_surface_set_label_func(surface, weston_shell_utils_surface_get_label);
+	/* xdg-shell adds a toplevel at its first commit, after SDL set the title */
+	shsurf->overlay = is_overlay(desktop_surface);
+	if (shsurf->overlay) {
+		kiosk_shell_surface_set_output(shsurf,
+			kiosk_shell_surface_find_best_output(shsurf));
+		shsurf->appid_output_assigned = true;
+		return;
+	}
 	kiosk_shell_surface_set_fullscreen(shsurf, NULL);
 }
 
@@ -992,6 +1013,32 @@
 	if (surface->width == 0)
 		return;
 
+	/* The OSD top centre, 40 px down; the performance overlay in the
+	 * corner its title names ("perf bottom-right"), else top left */
+	if (shsurf->overlay) {
+		if (!weston_surface_is_mapped(surface) && shsurf->output) {
+			struct weston_output *output = shsurf->output->output;
+			struct weston_coord_global pos = output->pos;
+			const char *title =
+				weston_desktop_surface_get_title(desktop_surface);
+
+			if (strcmp(title, "osd") == 0) {
+				pos.c.x += (output->width - surface->width) / 2;
+				pos.c.y += 40;
+			} else {
+				if (strstr(title, "right"))
+					pos.c.x += output->width - surface->width;
+				if (strstr(title, "bottom"))
+					pos.c.y += output->height - surface->height;
+			}
+			weston_view_set_position(shsurf->view, pos);
+			weston_view_move_to_layer(shsurf->view,
+						  &shsurf->shell->overlay_layer.view_list);
+			weston_surface_map(surface);
+		}
+		return;
+	}
+
 	if (!shsurf->appid_output_assigned && app_id) {
 		struct kiosk_shell_output *shoutput = NULL;
 
@@ -1426,6 +1473,8 @@
 	weston_layer_fini(&shell->background_layer);
 	kiosk_shell_destroy_surfaces_on_layer(&shell->normal_layer);
 	kiosk_shell_destroy_surfaces_on_layer(&shell->inactive_layer);
+	kiosk_shell_destroy_surfaces_on_layer(&shell->overlay_layer);
+	wl_list_remove(&shell->screenshot_auth.link);
 
 	wl_list_for_each_safe(shseat, shseat_next, &shell->seat_list, link) {
 		kiosk_shell_seat_destroy(shseat);
@@ -1436,6 +1485,15 @@
 	free(shell);
 }
 
+/* Every client is the player's on the handheld: the launcher's pause screen
+ * captures the app it covers. */
+static void
+kiosk_shell_authorize_screenshot(struct wl_listener *l,
+				 struct weston_output_capture_attempt *att)
+{
+	att->authorized = true;
+}
+
 static void
 kiosk_shell_notify_session(struct wl_listener *listener, void *data)
 {
@@ -1492,6 +1550,7 @@
 	weston_layer_init(&shell->background_layer, ec);
 	weston_layer_init(&shell->normal_layer, ec);
 	weston_layer_init(&shell->inactive_layer, ec);
+	weston_layer_init(&shell->overlay_layer, ec);
 
 	weston_layer_set_position(&shell->background_layer,
 				  WESTON_LAYER_POSITION_BACKGROUND);
@@ -1501,6 +1560,8 @@
 	 * are placed at NORMAL+1, are visible.  */
 	weston_layer_set_position(&shell->normal_layer,
 				  WESTON_LAYER_POSITION_NORMAL);
+	weston_layer_set_position(&shell->overlay_layer,
+				  WESTON_LAYER_POSITION_TOP_UI);
 
 	shell->desktop = weston_desktop_create(ec, &kiosk_shell_desktop_api,
 					       shell);
@@ -1529,6 +1590,8 @@
 	shell->session_listener.notify = kiosk_shell_notify_session;
 	wl_signal_add(&ec->session_signal, &shell->session_listener);
 	screenshooter_create(ec);
+	weston_compositor_add_screenshot_authority(ec, &shell->screenshot_auth,
+						   kiosk_shell_authorize_screenshot);
 
 	kiosk_shell_add_bindings(shell);
 
--- a/kiosk-shell/kiosk-shell.h
+++ b/kiosk-shell/kiosk-shell.h
@@ -42,6 +42,8 @@
 	struct weston_layer background_layer;
 	struct weston_layer normal_layer;
 	struct weston_layer inactive_layer;
+	struct weston_layer overlay_layer;
+	struct wl_listener screenshot_auth;
 
 	struct wl_list output_list;
 	struct wl_list seat_list;
@@ -80,6 +82,7 @@
 	} xwayland;
 
 	bool appid_output_assigned;
+	bool overlay;
 };
 
 struct kiosk_shell_seat {
