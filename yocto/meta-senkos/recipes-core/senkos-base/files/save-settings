#!/bin/sh
# Brightness for the next boot (boot.cmd), only written when changed
f=/uboot/brightness.txt
read -r b < /sys/class/backlight/backlight/brightness || exit 0
[ "$b" -gt 0 ] || exit 0	# never boot to a dark panel
[ "$(cat $f 2>/dev/null)" = "brightness=$b" ] && exit 0
echo "brightness=$b" > $f.new && mv $f.new $f
