# TF2 (mmc1 alias; TF1 = mmcblk0 is the system card): mount any filesystem on it at /run/media/<dev>.
# FAT and exFAT use the player's IDs; other filesystems map the card's root owner to the player.
ACTION=="add", SUBSYSTEM=="block", KERNEL=="mmcblk1*", ENV{ID_FS_USAGE}=="filesystem", RUN+="/usr/sbin/sdcard-mount %k"
# MTP and SMB (`usb`) have the mounted partitions: again with what's mounted now
ACTION=="add", SUBSYSTEM=="block", KERNEL=="mmcblk1*", ENV{ID_FS_USAGE}=="filesystem", RUN+="/bin/sh -c '/usr/sbin/usb cards </dev/null >/dev/null 2>&1 &'"
ACTION=="remove", SUBSYSTEM=="block", KERNEL=="mmcblk1*", RUN+="/bin/sh -c 'umount -l /run/media/%k && rmdir /run/media/%k'"
ACTION=="remove", SUBSYSTEM=="block", KERNEL=="mmcblk1*", RUN+="/bin/sh -c '/usr/sbin/usb cards </dev/null >/dev/null 2>&1 &'"
