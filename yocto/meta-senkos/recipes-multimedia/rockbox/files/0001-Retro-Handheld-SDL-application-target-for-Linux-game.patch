diff --git a/firmware/target/hosted/sdl/button-sdl.c b/firmware/target/hosted/sdl/button-sdl.c
index a329bb6..ee2adaa 100644
--- a/firmware/target/hosted/sdl/button-sdl.c
+++ b/firmware/target/hosted/sdl/button-sdl.c
@@ -285,6 +285,29 @@ static bool event_handler(SDL_Event *event)
         ev_key = event->key.keysym.sym;
         button_event(ev_key, event->type == SDL_KEYDOWN);
         break;
+#if defined(RETRO_HANDHELD) && !defined(SIMULATOR)
+    case SDL_CONTROLLERDEVICEADDED:
+        SDL_GameControllerOpen(event->cdevice.which);
+        break;
+    case SDL_CONTROLLERBUTTONDOWN:
+    case SDL_CONTROLLERBUTTONUP:
+        /* As the keys a keyboard (or gptokeyb) would press */
+        button_event(controller_to_key(event->cbutton.button), event->type == SDL_CONTROLLERBUTTONDOWN);
+        break;
+    case SDL_CONTROLLERAXISMOTION:
+    {
+        /* L2 and R2: triggers, held past half way */
+        static bool held[2];
+        const int i = event->caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT ? 0
+                    : event->caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT ? 1 : -1;
+        if (i >= 0 && held[i] != (event->caxis.value > 16384))
+        {
+            held[i] = !held[i];
+            button_event(i == 0 ? SDLK_z : SDLK_c, held[i]);
+        }
+        break;
+    }
+#endif
 
 
 
