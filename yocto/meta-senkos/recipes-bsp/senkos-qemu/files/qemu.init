#!/bin/sh
# qemu (tools/qemu): the buttons from the keyboard (qemupad), and 10.55.0.1, the handheld's
# address on its USB cable, on qemu's user network instead (tools/qemu forwards ssh to it)
[ "$1" = start ] || exit 0
qemupad </dev/null >/dev/kmsg 2>&1
ip addr add 10.55.0.1/24 dev eth0
ip link set eth0 up
ip route add default via 10.55.0.2
echo "nameserver 10.55.0.3" > /etc/resolv.conf
