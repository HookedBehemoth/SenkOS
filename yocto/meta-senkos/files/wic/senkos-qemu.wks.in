# senkos.wks.in for qemu: no U-Boot (qemu loads the kernel itself, tools/qemu), an empty boot
# partition for the A/B state; `ab mount` adds p4 (/data) on the first boot like on a card.
part --fstype=vfat --label boot --active --align 4096 --fixed-size 64M
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_NAME}.squashfs-lz4" --align 4096 --fixed-size 512M
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_NAME}.squashfs-lz4" --align 4096 --fixed-size 512M

bootloader --ptable msdos --diskid 0x52473335
