# SPL+U-Boot at 8 KiB (where the H700 BROM looks for eGON.BT0), then boot + rootfs.
part u-boot --source rawcopy --sourceparams="file=u-boot-sunxi-with-spl.bin" --no-table --align 8
part /boot --source bootimg_partition --sourceparams="loader=u-boot" --fstype=vfat --label boot --active --align 4096 --fixed-size 64M
part / --source rootfs --fstype=ext4 --label root --align 4096

bootloader --ptable msdos --diskid 0x52473335 --configfile="rg35xx-sp-extlinux.conf"
