index 3f437d0..11d306f 100644
--- a/meson.options
+++ b/meson.options
@@ -915,3 +915,12 @@ option(
   value : false,
   description : 'Build panfrost Rust components.'
 )
+
+option(
+  'panfrost-archs',
+  type : 'array',
+  value : ['4', '5', '6', '7', '9', '10', '11', '12', '13', '14'],
+  choices : ['4', '5', '6', '7', '9', '10', '11', '12', '13', '14'],
+  description : 'Mali architecture versions (GPU_ID major) panfrost and panvk are built for. ' +
+                'Each one is a copy of the per-arch code, shaders included.'
+)
