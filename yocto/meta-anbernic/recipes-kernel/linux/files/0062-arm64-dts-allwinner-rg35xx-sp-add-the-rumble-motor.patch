From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SenkOS
Date: Tue, 13 Oct 2026 21:40:00 +0200
Subject: [PATCH] arm64: dts: allwinner: rg35xx-sp: add the rumble motor

The SP's vibration motor hangs off PH2 (the stock firmware's
moto_pwm_gpio, pwm2 in its pin table): high runs it. As a pwm-vibrator
it is a force feedback input device, its strength pwm2's duty cycle at
20 kHz.

Upstream-Status: Pending
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
@@ -25,6 +25,15 @@
 			wakeup-source;
 		};
 	};
+
+	/* The rumble motor on PH2: pwm2's duty is its strength */
+	vibrator {
+		compatible = "pwm-vibrator";
+		pwms = <&pwm 2 50000 0>;
+		pwm-names = "enable";
+		pinctrl-0 = <&rumble_pin>;
+		pinctrl-names = "default";
+	};
 };
 
 /* The SP's X and Y keys are wired the other way round from the 2024's */
@@ -38,6 +47,13 @@
 	};
 };
 
+&pio {
+	rumble_pin: pwm2-ph-pin {
+		pins = "PH2";
+		function = "pwm2";
+	};
+};
+
 &r_i2c {
 	rtc_ext: rtc@51 {
 		compatible = "nxp,pcf8563";
