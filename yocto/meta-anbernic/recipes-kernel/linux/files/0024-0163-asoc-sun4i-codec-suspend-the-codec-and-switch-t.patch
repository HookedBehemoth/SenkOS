 	if (IS_ERR(scodec->clk_module)) {
 		dev_err(&pdev->dev, "Failed to get the module clock\n");
@@ -2351,6 +2539,15 @@ static int sun4i_codec_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	scodec->pa_reg = devm_regulator_get_optional(&pdev->dev, "allwinner,pa");
