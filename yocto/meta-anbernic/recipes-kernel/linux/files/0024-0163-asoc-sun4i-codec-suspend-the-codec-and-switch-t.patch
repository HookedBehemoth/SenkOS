+	.suspend_resources = true,
 	.codec		= &sun50i_h616_codec_codec,
 	.create_card	= sun50i_h616_codec_create_card,
 	.reg_dac_fifoc	= REG_FIELD(SUN50I_H616_CODEC_DAC_FIFOC, 0, 31),
@@ -2290,6 +2359,114 @@ static const struct of_device_id sun4i_codec_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, sun4i_codec_of_match);
 
+static void sun4i_codec_disable_apb(void *data)
+{
+	struct sun4i_codec *scodec = data;
+
+	if (scodec->apb_enabled) {
+		clk_disable_unprepare(scodec->clk_apb);
+		scodec->apb_enabled = false;
+	}
+}
+
+#ifdef CONFIG_PM_SLEEP
+/* ASoC must stop DMA and finish its register accesses before clocks go away. */
+static int sun4i_codec_suspend_late(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+	unsigned int i;
+	int ret, users;
+
+	/* DAPM has powered the speaker path down; make sure the rail follows. */
+	sun4i_codec_set_pa(scodec, false);
+
+	if (!scodec->suspend_resources || !snd_soc_card_is_instantiated(card))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(sun50i_h616_codec_pm_regs); i++) {
+		ret = regmap_read(scodec->regmap, sun50i_h616_codec_pm_regs[i],
+				  &scodec->saved_regs[i]);
+		if (ret)
+			return ret;
+	}
+
+	/* FIFO flushing and DMA requests belong to the PCM trigger sequence. */
+	scodec->saved_regs[SUN50I_H616_CODEC_PM_DAC_FIFOC] &=
+		~(BIT(SUN4I_CODEC_DAC_FIFOC_FIFO_FLUSH) |
+		  BIT(SUN4I_CODEC_DAC_FIFOC_DAC_DRQ_EN));
+	users = atomic_read(&scodec->module_clk_users);
+	while (users--)
+		clk_disable_unprepare(scodec->clk_module);
+	sun4i_codec_disable_apb(scodec);
+	scodec->clocks_suspended = true;
+
+	return 0;
+}
+
+static int sun4i_codec_resume_early(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+	unsigned int i;
+	int ret, enabled = 0, users;
+
+	if (!scodec->clocks_suspended)
+		return 0;
+
+	ret = clk_prepare_enable(scodec->clk_apb);
+	if (ret)
+		return ret;
+	scodec->apb_enabled = true;
+
+	users = atomic_read(&scodec->module_clk_users);
+	while (enabled < users) {
+		ret = clk_prepare_enable(scodec->clk_module);
+		if (ret)
+			goto err_clocks;
+		enabled++;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(sun50i_h616_codec_pm_regs); i++) {
+		ret = regmap_write(scodec->regmap, sun50i_h616_codec_pm_regs[i],
+				   scodec->saved_regs[i]);
+		if (ret)
+			goto err_clocks;
+	}
+	scodec->clocks_suspended = false;
+	return 0;
+
+err_clocks:
+	while (enabled--)
+		clk_disable_unprepare(scodec->clk_module);
+	sun4i_codec_disable_apb(scodec);
+	return ret;
+}
+
+static int sun4i_codec_resume(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+
+	/* A failed early resume must not schedule ASoC MMIO with clocks off. */
+	if (scodec->clocks_suspended)
+		return dev_err_probe(dev, -EIO, "Codec clocks did not resume\n");
+
+	return snd_soc_resume(dev);
+}
+
+static const struct dev_pm_ops sun4i_codec_pm_ops = {
+	.suspend = snd_soc_suspend,
+	.resume = sun4i_codec_resume,
+	.suspend_late = sun4i_codec_suspend_late,
+	.resume_early = sun4i_codec_resume_early,
+	.freeze = snd_soc_suspend,
+	.thaw = snd_soc_resume,
+	.poweroff = snd_soc_poweroff,
+	.restore = snd_soc_resume,
+};
+#endif
