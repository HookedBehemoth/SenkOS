From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SenkOS
Date: Thu, 8 Oct 2026 01:16:24 +0200
Subject: [PATCH] ASoC: sun4i-codec: keep the H616 module clock while the DAC
 is powered

The module clock went off when the PCM closed, but DAPM keeps the DAC
and the speaker amplifier powered for pmdown_time after that. Stopping
the clock under a powered DAC with the amplifier on pops: PipeWire's
device probing at boot (open, prepare, close, then quick open/close)
did it every boot. Make the clock a DAPM supply of the DAC, so it stops
only after DAPM has turned the amplifier off.

Upstream-Status: Pending
---
 sound/soc/sunxi/sun4i-codec.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sound/soc/sunxi/sun4i-codec.c b/sound/soc/sunxi/sun4i-codec.c
index 501f73ca1..e2c260602 100644
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -1989,6 +1989,13 @@ static const struct snd_kcontrol_new sun50i_h616_codec_lineout_src[] = {
 };
 
 static const struct snd_soc_dapm_widget sun50i_h616_codec_codec_widgets[] = {
+	/*
+	 * The module clock, for as long as the DACs are powered: stopping it with
+	 * the speaker amplifier still on (closing the PCM, which DAPM outlives by
+	 * pmdown_time) pops.
+	 */
+	SND_SOC_DAPM_CLOCK_SUPPLY("codec"),
+
 	/* Digital parts of the DACs */
 	SND_SOC_DAPM_SUPPLY("DAC Enable", SUN4I_CODEC_DAC_DPC,
 			    SUN4I_CODEC_DAC_DPC_EN_DA, 0,
@@ -2042,6 +2049,7 @@ static const struct snd_soc_dapm_widget sun50i_h616_codec_card_dapm_widgets[] =
 /* Connect digital side enables to analog side widgets */
 static const struct snd_soc_dapm_route sun50i_h616_codec_card_routes[] = {
 	/* DAC Routes */
+	{ "DAC Enable", NULL, "codec" },
 	{ "Left DAC", NULL, "DAC Enable" },
 	{ "Right DAC", NULL, "DAC Enable" },
 
