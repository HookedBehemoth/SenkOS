From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <rocknix@rocknix>
Date: Mon, 28 Sep 2026 17:43:54 +0200
Subject: [PATCH] 0156-rg35xx-plus-add-pcf8563-rtc

Imported from ROCKNIX distribution (projects/ROCKNIX/devices/H700/patches/linux), refreshed for linux 7.2.
Upstream-Status: Pending [ROCKNIX H700 series, https://github.com/ROCKNIX/distribution]
---
 .../allwinner/sun50i-h700-anbernic-rg35xx-plus.dts  | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-plus.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-plus.dts
index 950dbd39c..324de40dc 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-plus.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-plus.dts
@@ -10,6 +10,11 @@ / {
 	compatible = "anbernic,rg35xx-plus", "allwinner,sun50i-h700";
 	rocknix-dt-id = "sun50i-h700-anbernic-rg35xx-plus";
 
+	aliases {
+		rtc0 = &pcf8563;
+		rtc1 = &rtc;
+	};
+
 	wifi_pwrseq: pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		clocks = <&rtc CLK_OSC32K_FANOUT>;
@@ -33,6 +38,14 @@ sdio_wifi: wifi@1 {
 	};
 };
 
+&r_i2c {
+	pcf8563: rtc@51 {
+		compatible = "nxp,pcf8563";
+		reg = <0x51>;
+		#clock-cells = <0>;
+	};
+};
+
 /* Bluetooth RTL8821CS */
 &uart1 {
 	pinctrl-names = "default";
