From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SenkOS
Date: Wed, 7 Oct 2026 18:34:24 +0200
Subject: [PATCH 48/51] drm/sun4i: tcon: keep the dot clock divider across
 suspend

The dot clock divider lives in TCON0_DCLK, behind the clk framework's cached rate: after
super standby (the SoC's power cut) a modeset at the same rate doesn't write it again.
Save it with the clocks in suspend and write it back on resume.

Upstream-Status: Pending
---
 drivers/gpu/drm/sun4i/sun4i_tcon.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.c b/drivers/gpu/drm/sun4i/sun4i_tcon.c
index 6a5f8cbf6..3e5ff2a7e 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.c
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.c
@@ -47,6 +47,8 @@ struct sun4i_tcon_pm {
 	bool system_pm;
 	bool clocks_enabled;
 	bool clocks_suspended;
+	/* the dot clock divider, behind the clk framework's cached rate; lost in super standby */
+	u32 dclk;
 };
 
 static struct sun4i_tcon_pm *sun4i_tcon_pm(struct sun4i_tcon *tcon)
@@ -832,6 +834,8 @@ void sun4i_tcon_suspend(struct sun4i_tcon *tcon)
 
 	/* Drain handlers before either TCON or its associated mixer loses clocks. */
 	disable_irq(sun4i_tcon_pm(tcon)->irq);
+	if (tcon->quirks->has_channel_0)
+		regmap_read(tcon->regs, SUN4I_TCON0_DCLK_REG, &sun4i_tcon_pm(tcon)->dclk);
 	sun4i_tcon_disable_clocks(tcon);
 	sun4i_tcon_pm(tcon)->clocks_suspended = true;
 }
@@ -845,6 +849,8 @@ int sun4i_tcon_resume(struct sun4i_tcon *tcon)
 	ret = sun4i_tcon_enable_clocks(tcon);
 	if (ret)
 		return ret;
+	if (tcon->quirks->has_channel_0)
+		regmap_write(tcon->regs, SUN4I_TCON0_DCLK_REG, sun4i_tcon_pm(tcon)->dclk);
 	sun4i_tcon_pm(tcon)->clocks_suspended = false;
 	enable_irq(sun4i_tcon_pm(tcon)->irq);
 	return 0;
