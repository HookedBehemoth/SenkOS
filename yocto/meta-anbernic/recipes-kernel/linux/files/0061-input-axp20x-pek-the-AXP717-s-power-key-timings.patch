From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SenkOS
Date: Tue, 13 Oct 2026 12:00:00 +0200
Subject: [PATCH] input: axp20x-pek: the AXP717's power key timings

The AXP717 keeps its power key's times in register 0x26 (ONLEVEL bits
1:0: 128 ms, 512 ms, 1 s, 2 s; OFFLEVEL bits 3:2: 4, 6, 8, 10 s), not in
the AXP20x's 0x36, which the startup and shutdown attributes used. Give
the AXP717 its own cell and info with that register, and make it
writable.

Upstream-Status: Pending
---
 drivers/input/misc/axp20x-pek.c | 28 ++++++++++++++++++++++--
 drivers/mfd/axp20x.c            |  3 ++-
 include/linux/mfd/axp20x.h      |  1 +
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/drivers/input/misc/axp20x-pek.c b/drivers/input/misc/axp20x-pek.c
index 56479c8..5f84658 100644
--- a/drivers/input/misc/axp20x-pek.c
+++ b/drivers/input/misc/axp20x-pek.c
@@ -30,8 +30,11 @@
 
 #define AXP20X_PEK_STARTUP_MASK		(0xc0)
 #define AXP20X_PEK_SHUTDOWN_MASK	(0x03)
+#define AXP717_PEK_STARTUP_MASK		(0x03)
+#define AXP717_PEK_SHUTDOWN_MASK	(0x0c)
 
 struct axp20x_info {
+	unsigned int reg;
 	const struct axp20x_time *startup_time;
 	unsigned int startup_mask;
 	const struct axp20x_time *shutdown_time;
@@ -65,6 +68,13 @@ static const struct axp20x_time axp221_startup_time[] = {
 	{ .time = 3000, .idx = 3 },
 };
 
+static const struct axp20x_time axp717_startup_time[] = {
+	{ .time = 128,  .idx = 0 },
+	{ .time = 512,  .idx = 1 },
+	{ .time = 1000, .idx = 2 },
+	{ .time = 2000, .idx = 3 },
+};
+
 static const struct axp20x_time shutdown_time[] = {
 	{ .time = 4000,  .idx = 0 },
 	{ .time = 6000,  .idx = 1 },
@@ -73,6 +83,7 @@ static const struct axp20x_time shutdown_time[] = {
 };
 
 static const struct axp20x_info axp20x_info = {
+	.reg = AXP20X_PEK_KEY,
 	.startup_time = startup_time,
 	.startup_mask = AXP20X_PEK_STARTUP_MASK,
 	.shutdown_time = shutdown_time,
@@ -80,12 +91,21 @@ static const struct axp20x_info axp20x_info = {
 };
 
 static const struct axp20x_info axp221_info = {
+	.reg = AXP20X_PEK_KEY,
 	.startup_time = axp221_startup_time,
 	.startup_mask = AXP20X_PEK_STARTUP_MASK,
 	.shutdown_time = shutdown_time,
 	.shutdown_mask = AXP20X_PEK_SHUTDOWN_MASK,
 };
 
+static const struct axp20x_info axp717_info = {
+	.reg = AXP717_PEK_KEY,
+	.startup_time = axp717_startup_time,
+	.startup_mask = AXP717_PEK_STARTUP_MASK,
+	.shutdown_time = shutdown_time,
+	.shutdown_mask = AXP717_PEK_SHUTDOWN_MASK,
+};
+
 static ssize_t axp20x_show_attr(struct device *dev,
 				const struct axp20x_time *time,
 				unsigned int mask, char *buf)
@@ -94,7 +114,7 @@ static ssize_t axp20x_show_attr(struct device *dev,
 	unsigned int val;
 	int ret, i;
 
-	ret = regmap_read(axp20x_pek->axp20x->regmap, AXP20X_PEK_KEY, &val);
+	ret = regmap_read(axp20x_pek->axp20x->regmap, axp20x_pek->info->reg, &val);
 	if (ret != 0)
 		return ret;
 
@@ -156,7 +176,7 @@ static ssize_t axp20x_store_attr(struct device *dev,
 	}
 
 	idx <<= ffs(mask) - 1;
-	ret = regmap_update_bits(axp20x_pek->axp20x->regmap, AXP20X_PEK_KEY,
+	ret = regmap_update_bits(axp20x_pek->axp20x->regmap, axp20x_pek->info->reg,
 				 mask, idx);
 	if (ret != 0)
 		return -EINVAL;
@@ -403,6 +423,10 @@ static const struct platform_device_id axp_pek_id_match[] = {
 		.name = "axp221-pek",
 		.driver_data = (kernel_ulong_t)&axp221_info,
 	},
+	{
+		.name = "axp717-pek",
+		.driver_data = (kernel_ulong_t)&axp717_info,
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(platform, axp_pek_id_match);
diff --git a/drivers/mfd/axp20x.c b/drivers/mfd/axp20x.c
index 0640c8c..94f9f97 100644
--- a/drivers/mfd/axp20x.c
+++ b/drivers/mfd/axp20x.c
@@ -222,6 +222,7 @@ static const struct regmap_range axp717_writeable_ranges[] = {
 	regmap_reg_range(AXP717_PMU_FAULT, AXP717_MODULE_EN_CONTROL_1),
 	regmap_reg_range(AXP717_MIN_SYS_V_CONTROL, AXP717_BOOST_CONTROL),
 	regmap_reg_range(AXP717_VSYS_V_POWEROFF, AXP717_VSYS_V_POWEROFF),
+	regmap_reg_range(AXP717_PEK_KEY, AXP717_PEK_KEY),
 	regmap_reg_range(AXP717_IRQ0_EN, AXP717_IRQ4_EN),
 	regmap_reg_range(AXP717_IRQ0_STATE, AXP717_IRQ4_STATE),
 	regmap_reg_range(AXP717_TS_PIN_CFG, AXP717_TS_PIN_CFG),
@@ -1071,7 +1072,7 @@ static struct mfd_cell axp313a_cells[] = {
 
 static struct mfd_cell axp717_cells[] = {
 	MFD_CELL_NAME("axp20x-regulator"),
-	MFD_CELL_RES("axp20x-pek", axp717_pek_resources),
+	MFD_CELL_RES("axp717-pek", axp717_pek_resources),
 	MFD_CELL_OF("axp717-adc",
 		    NULL, NULL, 0, 0, "x-powers,axp717-adc"),
 	MFD_CELL_OF("axp20x-usb-power-supply",
diff --git a/include/linux/mfd/axp20x.h b/include/linux/mfd/axp20x.h
index b352661..6b2b9fb 100644
--- a/include/linux/mfd/axp20x.h
+++ b/include/linux/mfd/axp20x.h
@@ -127,6 +127,7 @@ enum axp20x_variants {
 #define AXP717_MODULE_EN_CONTROL_2	0x19
 #define AXP717_BOOST_CONTROL		0x1e
 #define AXP717_VSYS_V_POWEROFF		0x24
+#define AXP717_PEK_KEY			0x26
 #define AXP717_IRQ0_EN			0x40
 #define AXP717_IRQ1_EN			0x41
 #define AXP717_IRQ2_EN			0x42
