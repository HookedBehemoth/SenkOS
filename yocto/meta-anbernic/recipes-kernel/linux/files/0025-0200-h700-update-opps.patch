From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <rocknix@rocknix>
Date: Mon, 28 Sep 2026 17:43:56 +0200
Subject: [PATCH] 0200-h700-update-opps

Imported from ROCKNIX distribution (projects/ROCKNIX/devices/H700/patches/linux), refreshed for linux 7.2.
Upstream-Status: Pending [ROCKNIX H700 series, https://github.com/ROCKNIX/distribution]
---
 arch/arm64/boot/dts/allwinner/sun50i-h616-cpu-opp.dtsi | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-cpu-opp.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616-cpu-opp.dtsi
index dd10aaf47..384cbffae 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616-cpu-opp.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616-cpu-opp.dtsi
@@ -55,13 +55,6 @@ opp-1008000000 {
 			opp-supported-hw = <0x3f>;
 		};
 
-		opp-1032000000 {
-			opp-hz = /bits/ 64 <1032000000>;
-			opp-microvolt = <900000>;
-			clock-latency-ns = <244144>; /* 8 32k periods */
-			opp-supported-hw = <0x20>;
-		};
-
 		opp-1104000000 {
 			opp-hz = /bits/ 64 <1104000000>;
 			opp-microvolt-speed0 = <1000000>;
@@ -88,7 +81,7 @@ opp-1320000000 {
 			opp-hz = /bits/ 64 <1320000000>;
 			opp-microvolt = <1100000>;
 			clock-latency-ns = <244144>; /* 8 32k periods */
-			opp-supported-hw = <0x1d>;
+			opp-supported-hw = <0x3d>;
 		};
 
 		opp-1416000000 {
@@ -105,6 +98,7 @@ opp-1512000000 {
 			opp-microvolt-speed5 = <1160000>;
 			clock-latency-ns = <244144>; /* 8 32k periods */
 			opp-supported-hw = <0x2a>;
+			turbo-mode;
 		};
 	};
 };
