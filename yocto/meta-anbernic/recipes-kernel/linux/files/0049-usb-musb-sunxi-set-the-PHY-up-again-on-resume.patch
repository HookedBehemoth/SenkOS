From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SenkOS
Date: Wed, 7 Oct 2026 18:36:34 +0200
Subject: [PATCH 49/51] usb: musb: sunxi: set the PHY up again on resume

The H616 suspends with the SoC's power cut (TF-A's super standby), PHY registers included.
PHY 0 is shared with EHCI 0 and OHCI 0, which release it for the sleep: release it in
suspend too, so the last user's phy_exit and the first user's phy_init (which also redoes
the ID/VBUS detection) really run, whatever order the async resume takes. Set the bus mode
up again before musb_resume(), a child, restores the controller.

Upstream-Status: Pending
---
 drivers/usb/musb/sunxi.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/usb/musb/sunxi.c b/drivers/usb/musb/sunxi.c
index a6bd3e968..1f4f8bb99 100644
--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -855,12 +855,41 @@ static const struct of_device_id sunxi_musb_match[] = {
 };
 MODULE_DEVICE_TABLE(of, sunxi_musb_match);
 
+/*
+ * The H616 suspends with the SoC's power cut (TF-A's super standby), PHY registers
+ * included. PHY 0 is shared with EHCI 0 and OHCI 0, which let go of it for the sleep:
+ * let go too, so whichever resumes first sets it up again. The bus mode before
+ * musb_resume() (a child, so later) restores the controller.
+ */
+static int sunxi_musb_suspend(struct device *dev)
+{
+	struct sunxi_glue *glue = dev_get_drvdata(dev);
+
+	if (!sunxi_musb)
+		return 0;
+	return phy_exit(glue->phy);
+}
+
+static int sunxi_musb_resume(struct device *dev)
+{
+	struct sunxi_glue *glue = dev_get_drvdata(dev);
+
+	if (!sunxi_musb)
+		return 0;
+
+	writeb(SUNXI_MUSB_VEND0_PIO_MODE, sunxi_musb->mregs + SUNXI_MUSB_VEND0);
+	return phy_init(glue->phy);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sunxi_musb_pm_ops, sunxi_musb_suspend, sunxi_musb_resume);
+
 static struct platform_driver sunxi_musb_driver = {
 	.probe = sunxi_musb_probe,
 	.remove = sunxi_musb_remove,
 	.driver = {
 		.name = "musb-sunxi",
 		.of_match_table = sunxi_musb_match,
+		.pm = pm_sleep_ptr(&sunxi_musb_pm_ops),
 	},
 };
 module_platform_driver(sunxi_musb_driver);
