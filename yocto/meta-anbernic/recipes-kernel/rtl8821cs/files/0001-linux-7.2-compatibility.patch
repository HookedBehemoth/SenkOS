+/* Preserve fixed-width, NUL-padding semantics for legacy vendor callers.
+ * Several callers copy non-terminated substrings, so strscpy is not equivalent.
+ */
+static inline char *rtw_legacy_strncpy(char *dst, const char *src, size_t count)
+{
+	size_t len = strnlen(src, count);
+	memcpy(dst, src, len);
+	memset(dst + len, 0, count - len);
+	return dst;
+}
