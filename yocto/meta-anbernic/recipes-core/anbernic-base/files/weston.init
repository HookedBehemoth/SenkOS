#!/bin/sh
# The UI as early as boot allows (rcS S01), in the background while the rest of rcS runs: udev
# coldplug included, libinput adds input devices as udev gets to them.
# /data first: logs, user init scripts and HOME (fontconfig, Mesa's shader cache) live there.
# Then seatd, and as player (`session`): Weston on the LCD (DRM backend, kiosk shell: every
# client fullscreen) and the launcher (one in /data/OS/overlay replaces the image's: `overlay`,
# tools/deploy-launcher). The launcher is restarted whenever it exits, so a deploy only has to kill the old one.
if [ "$1" = session ]; then
	weston --backend=drm --shell=kiosk --modules=volume-keys.so --socket=$WAYLAND_DISPLAY \
		--log=/var/log/weston.log </dev/null >/dev/null 2>&1 &
	while :; do
		# SDL gives up on wayland if the socket isn't there yet
		while [ ! -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ]; do usleep 20000; done
		launcher
		sleep 1
	done
fi
# seatd, then the session as player. Again (`restart`) after `ums` stopped it: seatd still runs.
ui() {
	export HOME=/data
	# Settings in OS/config (corehost's, the media player's, the launcher's); state and caches
	# stay in HOME's .local/state and .cache. The cores' saves in OS/saves/CORE, what they need
	# (BIOS files, PPSSPP's assets) in OS/assets/emulator.
	export XDG_CONFIG_HOME=/data/OS/config COREHOST_SAVE=/data/OS/saves COREHOST_SYSTEM=/data/OS/assets/emulator
	. /etc/profile.d/wayland.sh
	. /etc/profile.d/panvk.sh
	. /etc/profile.d/zz-data.sh
	mkdir -p -m 0700 $XDG_RUNTIME_DIR
	chown player:player $XDG_RUNTIME_DIR
	# Mesa (kmsro) opens the panfrost render node itself, as the player, not through seatd. devtmpfs
	# creates it 0600 root and udev (S04, after us) only later makes it 0666: Weston's EGL init lost
	# that race once Mesa got small enough to load before udev ran. Same mode udev's default rule sets.
	chgrp video /dev/dri/renderD*
	chmod 0666 /dev/dri/renderD*
	(
		echo 0 > $c/ui/cgroup.procs
		[ -S /run/seatd.sock ] || seatd -g seat </dev/null >/dev/null 2>&1 &
		while [ ! -S /run/seatd.sock ]; do usleep 5000; done
		exec su -p -s /bin/sh player -c "$0 session"
	) </dev/null >/var/log/launcher.log 2>&1 &
}
[ "$1" = restart ] && { c=/sys/fs/cgroup/session; ui; exit 0; }
[ "$1" = start ] || exit 0

# Mesa in one sequential read, from the start: Weston's GL init page-faulting it in from squashfs
# took ~400 ms more than with a warm cache. Launcher up at 1.80 s instead of 1.92 s with this
# started right before Weston: reading it slows everything below, but less than it saves.
cat /usr/lib/libgallium-*.so >/dev/null &

# cgroup v2: the UI (seatd, Weston, launcher) and the apps the launcher starts. Apps get all the
# RAM but 160 MB, and run out of it on their own: the OOM kill takes the whole app. The UI wins
# CPU contention 10:1 and keeps its pages (Mesa included) when memory gets tight. The player may
# move its processes between the two (the launcher moves each app), the limits are root's.
c=/sys/fs/cgroup/session
mount -t cgroup2 none /sys/fs/cgroup
echo "+cpu +memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
mkdir $c $c/ui $c/apps
echo "+cpu +memory +pids" > $c/cgroup.subtree_control
echo 1000 > $c/ui/cpu.weight
echo 64M > $c/ui/memory.low
echo $(($(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo) / 1024 - 160))M > $c/apps/memory.max
echo 1 > $c/apps/memory.oom.group
echo 1024 > $c/apps/pids.max
chown player:player $c/cgroup.procs $c/ui/cgroup.procs $c/apps/cgroup.procs

ab mount	# /uboot, /data: mount points exist in the (read-only) image
# What root runs or trusts from /data is root's, so a game (as player) can't break the OS:
# /data (HOME) and /data/OS are root:player 1775, the player creates in them but can't rename
# or delete root's entries (sticky). Edited as root (ssh), or from a PC over UMS.
chown root:player /data /data/OS
chmod 1775 /data /data/OS
for d in init.d overlay profile.d dropbear; do
	d=/data/OS/$d
	[ -L $d ] && rm $d
	mkdir -p $d
	chown -R root:root $d
	chmod -R go-w $d
done
overlay	# /data/OS/overlay over the rootfs, before anything runs from it

# Persistent /var/log: the last 5 boots in /data/OS/log/0..4, 0 = this one. Apps log there too.
l=/data/OS/log
rm -rf $l/4
for i in 3 2 1 0; do [ -d $l/$i ] && mv $l/$i $l/$((i + 1)); done
mkdir -p $l/0 /var/volatile/log
# The card's, so the player's: what root writes (syslogd, login, the launcher's redirect) goes
# into files made for it here, which keep their owner (dmesg: anbernic.init). The rest (a
# rotated messages.0) from the boots before.
for f in messages wtmp launcher.log; do : > $l/0/$f; done
chown -R player:player $l
mount --bind $l/0 /var/volatile/log
mkdir -p -m 1777 /var/volatile/tmp

/etc/init.d/data-init start

ui
