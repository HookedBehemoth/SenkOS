#!/bin/sh
# The UI (rcS S01): /data, then seatd, the session as player (Weston, PipeWire) and the launcher as
# root (it drops to shell itself). The rest of rcS waits for the launcher's first frame.
# Waits (3 s at most) for the launcher's first frame: what isn't needed for it starts after
first_frame() {
	n=0
	while [ $n -lt 150 ]; do
		while read -r x; do
			case $x in "first frame"*) return ;; esac
		done 2>/dev/null </var/log/launcher.log
		usleep 20000
		n=$((n + 1))
	done
}
if [ "$1" = session ]; then
	# Weston's and PipeWire's sockets are the group's too: the launcher (shell) is in the player's group
	umask 002
	(
		first_frame
		pipewire </dev/null >/var/log/pipewire.log 2>&1 &
		wireplumber </dev/null >/var/log/wireplumber.log 2>&1 &
		pipewire-pulse </dev/null >/var/log/pipewire-pulse.log 2>&1 &
	) &
	exec weston --backend=drm --shell=kiosk --modules=frames.so --socket=$WAYLAND_DISPLAY \
		--log=/var/log/weston.log </dev/null >/dev/null 2>&1
fi
ui() {
	export HOME=/data
	export XDG_CONFIG_HOME=/data/OS/config COREHOST_SAVE=/data/OS/saves COREHOST_SYSTEM=/data/OS/assets/emulator
	. /etc/profile.d/wayland.sh
	. /etc/profile.d/panvk.sh
	. /etc/profile.d/zz-data.sh
	# The player's runtime dir (shell reads Weston's socket there), shell's own, the launcher's FIFO
	mkdir -p $XDG_RUNTIME_DIR
	chown player:player $XDG_RUNTIME_DIR
	chmod 0750 $XDG_RUNTIME_DIR
	s=/run/user/$(id -u shell)
	mkdir -p -m 0700 $s
	chown shell:shell $s
	[ -p /run/launcher ] || mkfifo -m 0620 /run/launcher
	chown shell:player /run/launcher
	mkdir -p /data/OS/launcher
	chown shell:shell /data/OS/launcher
	# What udev's coldplug (S04, after the first frame) would set: Mesa opens the render node as the
	# player, the launcher the buttons and the sound card as shell
	chgrp video /dev/dri/renderD*
	chgrp input /dev/input/event*
	chgrp audio /dev/snd/*
	chmod 0666 /dev/dri/renderD*
	chmod 0660 /dev/input/event* /dev/snd/*
	(
		echo 0 > $c/ui/cgroup.procs
		seatd -g seat </dev/null >/dev/null 2>&1 &
		while [ ! -S /run/seatd.sock ]; do usleep 5000; done
		su -p -s /bin/sh player -c "$0 session" &
		while :; do
			launcher
			sleep 1
		done
	) </dev/null >/var/log/launcher.log 2>&1 &
}
[ "$1" = start ] || exit 0

# Mesa in one sequential read: faulting it in from squashfs during Weston's GL init is slower
cat /usr/lib64/libgallium-*.so >/dev/null &

# cgroup v2: the UI wins CPU 10:1 and keeps its pages; apps get all RAM but 160 MB, OOM kills the whole app
c=/sys/fs/cgroup/session
mount -t cgroup2 none /sys/fs/cgroup
echo "+cpu +memory +pids" > /sys/fs/cgroup/cgroup.subtree_control
mkdir $c $c/ui $c/apps
echo "+cpu +memory +pids" > $c/cgroup.subtree_control
echo 1000 > $c/ui/cpu.weight
echo 64M > $c/ui/memory.low
echo $(($(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo) / 1024 - 160))M > $c/apps/memory.max
echo 1 > $c/apps/memory.oom.group
echo 1024 > $c/apps/pids.max
chown shell:shell $c/cgroup.procs $c/ui/cgroup.procs $c/apps/cgroup.procs

ab mount
# The player creates in /data and /data/OS but can't rename or delete root's entries
chown root:player /data /data/OS
chmod 1775 /data /data/OS
overlay

# /var/log: the last 5 boots in /data/OS/log/0..4, 0 = this one
l=/data/OS/log
rm -rf $l/4
for i in 3 2 1 0; do [ -d $l/$i ] && mv $l/$i $l/$((i + 1)); done
mkdir -p $l/0 /var/volatile/log
# The player's, like the rest of the card; 1: what root wrote there last boot (messages.0)
for f in messages wtmp launcher.log; do : > $l/0/$f; done
chown player:player $l
chown -R player:player $l/0 $l/1 2>/dev/null
mount --bind $l/0 /var/volatile/log
# .X11-unix: Weston exits without it, and populate-volatile (S37) comes too late
mkdir -p -m 1777 /var/volatile/tmp /var/volatile/tmp/.X11-unix

# The codec boots with its DAC muted
amixer -q -c 0 sset DAC unmute &

/etc/init.d/data-init start

# libinput gets hotplug events only while udevd runs: one for Weston's start. rcS S04 starts its
# own (and the coldplug) after the first frame.
udevd -d
ui
first_frame
udevadm control --exit
