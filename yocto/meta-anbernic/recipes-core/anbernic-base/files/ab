#!/bin/sh
# A/B slots (see meta-anbernic/recipes-bsp/u-boot/files/boot.cmd for the U-Boot side).
#   ab status        current slot, /uboot/ab.txt
#   ab mount         mount the FAT boot partition (A/B state) at /uboot, the data partition at /data
#   ab flash         write a squashfs rootfs image from stdin to the other slot, try it on next boot
#   ab write, ab arm the two halves of flash (downloadd checks the image between them)
#   ab commit        booted slot works: make it the default (tools/ota once ssh works, the launcher once up)
#   ab boot          end of boot: a slot on trial that isn't committed in 120 s reboots
set -e
cur=$(sed -n 's/.* ab=\([ab]\).*/\1/p' /proc/cmdline)
[ -n "$cur" ] || { echo "ab: no ab= on the kernel command line" >&2; exit 1; }
if [ $cur = a ]; then other=b; otherpart=3; else other=a; otherpart=2; fi
root=$(readlink -f /sys/dev/block/$(mountpoint -d /))
disk=/dev/$(basename $(dirname $root))
case $disk in *[0-9]) disk=${disk}p ;; esac

case "$1" in
status)
	echo "booted: $cur ($(basename $root))"
	cat /uboot/ab.txt 2>/dev/null | tr -d '\000' || true
	;;
mount)
	mountpoint -q /uboot || mount -t vfat -o noatime ${disk}1 /uboot
	# p4: ext4, rw, the rest of the card. wic doesn't know the card's size, so the first boot
	# makes it. The marker on /uboot says p4 is ours to format: nothing else ever gets mkfs'd.
	if [ ! -b ${disk}4 ]; then
		p3=/sys/class/block/$(basename ${disk}3)
		start=$(( ($(cat $p3/start) + $(cat $p3/size) + 8191) / 8192 * 8192 ))
		touch /uboot/data-new
		sync
		echo "start=$start, type=83" | sfdisk -q --force --append ${disk%p} ||
			{ rm /uboot/data-new; exit 1; }
	fi
	if [ -f /uboot/data-new ]; then
		for i in 1 2 3 4 5; do [ -b ${disk}4 ] && break; sleep 1; done
		if [ ! -b ${disk}4 ]; then
			echo "ab: rebooting so the kernel sees the new data partition" > /dev/console
			reboot
			exit 0
		fi
		echo "ab: formatting ${disk}4 for /data" > /dev/console
		mkfs.ext4 -q -F -L data -E nodiscard ${disk}4
		# What a new card starts with (anbernic-data); the marker goes once it's there
		mount -t ext4 -o noatime ${disk}4 /data
		cp -a /usr/share/anbernic/data/. /data/
		chown -R player:player /data
		sync
		rm /uboot/data-new
		sync
	fi
	mountpoint -q /data || mount -t ext4 -o noatime ${disk}4 /data
	;;
flash)
	"$0" write
	exec "$0" arm
	;;
write)
	echo "writing slot $other (${disk}$otherpart)..." >&2
	dd of=${disk}$otherpart bs=1M
	sync
	;;
arm)
	magic=$(dd if=${disk}$otherpart bs=4 count=1 2>/dev/null)
	[ "$magic" = hsqs ] || { echo "ab: slot $other is not a squashfs image, not switching" >&2; exit 1; }
	printf 'slot=%s\ntryslot=%s\ntries=0\n' $cur $other > /uboot/ab.txt
	sync
	echo "slot $other armed: reboot to try it (3 tries, then back to $cur)" >&2
	;;
boot)
	grep -qa '^tryslot=' /uboot/ab.txt 2>/dev/null || exit 0
	echo "ab: slot $cur on trial, reboot in 120 s unless committed" > /dev/console
	(sleep 120; grep -qa '^tryslot=' /uboot/ab.txt && reboot) </dev/null >/dev/null 2>&1 &
	;;
commit)
	grep -qa '^tryslot=' /uboot/ab.txt 2>/dev/null || exit 0
	printf 'slot=%s\n' $cur > /uboot/ab.txt
	sync
	echo "ab: slot $cur committed" >&2
	;;
*)
	sed -n '2,9s/^# \?//p' $0 >&2; exit 1 ;;
esac
