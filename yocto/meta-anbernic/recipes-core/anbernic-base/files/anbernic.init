#!/bin/sh
# Watchdog, USB gadget: NCM ethernet (10.55.0.1, DHCP for the host) + ACM serial (getty on
# ttyGS0, host sees /dev/ttyACM*). Mass storage is set up too, for `ums` to put in place of
# the serial port: musb doesn't have the endpoints for all three. /uboot and /data are mounted by /etc/init.d/weston (rcS S01).
[ "$1" = start ] || exit 0

# U-Boot armed the watchdog, sunxi_wdt disarmed it at probe; keep one running from here.
# `ab suspend`-style callers must stop this first (SIGTERM = magic close).
watchdog -T 16 -t 4 /dev/watchdog

mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
g=/sys/kernel/config/usb_gadget/g1
if [ ! -d $g ]; then
	mkdir $g
	echo 0x1d6b > $g/idVendor	# Linux Foundation
	echo 0x0104 > $g/idProduct	# Multifunction Composite Gadget
	mkdir $g/strings/0x409 $g/configs/c.1 $g/functions/ncm.usb0 $g/functions/acm.usb0 \
		$g/functions/mass_storage.0 $g/functions/mass_storage.0/lun.1
	echo 1 > $g/functions/mass_storage.0/lun.0/removable
	echo 1 > $g/functions/mass_storage.0/lun.1/removable
	echo SenkOS > $g/strings/0x409/manufacturer
	echo RG35XX-SP > $g/strings/0x409/product
	# fixed MACs: host keeps the same interface/connection across reboots
	echo 02:35:58:00:00:01 > $g/functions/ncm.usb0/dev_addr
	echo 02:35:58:00:00:02 > $g/functions/ncm.usb0/host_addr
	ln -s $g/functions/ncm.usb0 $g/configs/c.1/
	ln -s $g/functions/acm.usb0 $g/configs/c.1/
	# musb normally registers before root is mounted; give a late (async) probe up to 2 s
	n=0
	until udc=$(ls /sys/class/udc | head -n1) && [ -n "$udc" ] || [ $n -ge 100 ]; do usleep 20000; n=$((n + 1)); done
	echo $udc > $g/UDC
fi
ifc=$(cat $g/functions/ncm.usb0/ifname)
ip addr add 10.55.0.1/24 dev $ifc
ip link set $ifc up
udhcpd -S /etc/udhcpd.conf

usb-gadget-check </dev/null >/dev/null 2>&1 &

# The codec boots muted with Line Out (the speaker amp's input) at 0; no alsa-state to restore
amixer -q set 'Line Out' 70% unmute
amixer -q set DAC unmute

# lid close / power key -> suspend; /run/power: the launcher's (player's) suspend, reboot, poweroff
mkfifo -m 0620 /run/power && chgrp player /run/power
[ -x /usr/sbin/sleepd ] && sleepd > /dev/console 2>&1 &
