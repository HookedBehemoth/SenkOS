#!/bin/sh
# musb can come back detached from the host (boot, resume, replug): cable powered but the
# gadget "not attached" 5 and 10 s later -> rebind. And unbound: MTP's daemon closing FunctionFS
# (umtprd does after a disconnect) unbinds the whole gadget, and nothing else binds it again.
# One-shot, nothing polls: run at boot (/etc/init.d/anbernic), after resume (/usr/sbin/suspend)
# and on USB power changes (udev).
exec 9> /run/usb-gadget-check.lock
flock -n 9 || exit 0
g=/sys/kernel/config/usb_gadget/g1
udc=$(ls /sys/class/udc)
[ -n "$udc" ] && [ -d $g ] || exit 0
stuck() {
	read online < /sys/class/power_supply/axp20x-usb/online && [ "$online" = 1 ] &&
		{ [ -z "$(cat $g/UDC)" ] || { read state < /sys/class/udc/$udc/state && [ "$state" = "not attached" ]; }; }
}
sleep 5; stuck || exit 0
sleep 5; stuck || exit 0
echo "anbernic: USB gadget unbound or stuck detached, binding again" > /dev/kmsg
echo > $g/UDC 2>/dev/null
# FunctionFS refuses until its daemon has written its descriptors again
i=0
until sleep 1; echo $udc > $g/UDC 2>/dev/null || [ $i -ge 10 ]; do i=$((i + 1)); done
