+	else
+		mctl_set_timing_params(para);
 
 	writel(0, &mctl_ctl->pwrctl);
 
@@ -1340,19 +1358,69 @@ static const struct dram_para para = {
 	.tpr12 = CONFIG_DRAM_SUNXI_TPR12,
 };
 
+#ifdef CONFIG_SUNXI_DRAM_H616_LPDDR3_STRAPS
+/* boot0's LPDDR3 set, with the DX delays ROCKNIX runs LPDDR3 units with */
+static const struct dram_para para_lpddr3 = {
+	.clk = 672,
+	.type = SUNXI_DRAM_TYPE_LPDDR3,
+	.dx_odt = 0x06060606,
+	.dx_dri = 0x0d0d0d0d,
+	.ca_dri = 0x1919,
+	.odt_en = 0x9988eeee,
+	.tpr2 = 0x1,
+	.tpr6 = 0x2fb08080,
+	.tpr10 = 0x402f4489,
+	.tpr11 = 0x10121013,
+	.tpr12 = 0x0d0e0d0e,
+};
+
+/*
+ * boot0 picks its DRAM set from PH6, PH7, PH8 and PH10 (bits 0-3, pulled up):
+ * 14 is LPDDR3; 0 and 15 LPDDR4 (1-13 would be DDR3, not seen on boards).
+ */
+static bool dram_straps_lpddr3(void)
+{
+	static const u32 pins[] = { SUNXI_GPH(6), SUNXI_GPH(7), SUNXI_GPH(8), SUNXI_GPH(10) };
+	u32 idx = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+		sunxi_gpio_set_cfgpin(pins[i], SUNXI_GPIO_INPUT);
+		sunxi_gpio_set_pull(pins[i], SUNXI_GPIO_PULL_UP);
+	}
+	udelay(10);
+	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+		idx |= !!gpio_get_value(pins[i]) << i;
+		sunxi_gpio_set_pull(pins[i], SUNXI_GPIO_PULL_DISABLE);
+		sunxi_gpio_set_cfgpin(pins[i], SUNXI_GPIO_DISABLE);
+	}
+
+	return idx == 14;
+}
+#endif
+
 unsigned long sunxi_dram_init(void)
 {
 	void *const prcm = (void *)SUNXI_PRCM_BASE;
+	const struct dram_para *p = &para;
 	struct dram_config config;
 	unsigned long size;
 
+#ifdef CONFIG_SUNXI_DRAM_H616_LPDDR3_STRAPS
+	if (dram_straps_lpddr3()) {
+		/* SPL set DCDC3 (the DRAM supply) for LPDDR4; LPDDR3 needs 1.2 V */
+		axp_set_dcdc3(1200);
+		p = &para_lpddr3;
+	}
+#endif
+
 	setbits_le32(prcm + CCU_PRCM_RES_CAL_CTRL, BIT(8));
 	clrbits_le32(prcm + CCU_PRCM_OHMS240, 0x3f);
 
-	mctl_auto_detect_rank_width(&para, &config);
-	mctl_auto_detect_dram_size(&para, &config);
+	mctl_auto_detect_rank_width(p, &config);
+	mctl_auto_detect_dram_size(p, &config);
 
-	mctl_core_init(&para, &config);
+	mctl_core_init(p, &config);
 
 	size = mctl_calc_size(&config);
 
