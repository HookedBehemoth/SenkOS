Subject: [PATCH] bootstage marks for boot-time measurement (UBOOT_BOOTSTAGE)

Upstream-Status: Inappropriate [measurement only; the bootstage_unstash() name index fix is upstreamable]
---
--- a/boot/image-fdt.c
+++ b/boot/image-fdt.c
@@ -699,7 +699,7 @@
 	if (CONFIG_IS_ENABLED(LMB) && lmb)
 		lmb_free(map_to_sysmem(blob), fdt_totalsize(blob), LMB_NONE);
 
-	ret = fdt_shrink_to_minimum(blob, 0);
+	ret = fdt_shrink_to_minimum(blob, 0x2000);
 	if (ret < 0)
 		goto err;
 	of_size = ret;
--- a/common/board_f.c
+++ b/common/board_f.c
@@ -915,6 +915,7 @@
 	INITCALL(arch_cpu_init);	/* basic arch cpu dependent setup */
 	INITCALL(mach_cpu_init);	/* SoC/machine dependent CPU setup */
 	INITCALL(initf_dm);
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "f_dm");
 #if CONFIG_IS_ENABLED(BOARD_EARLY_INIT_F)
 	INITCALL(board_early_init_f);
 #endif
@@ -931,6 +932,7 @@
 	INITCALL(env_init);		/* initialize environment */
 	INITCALL(init_baud_rate);	/* initialze baudrate settings */
 	INITCALL(serial_init_f);	/* serial communications setup */
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "f_serial");
 	INITCALL(console_init_f);	/* stage 1 init of console */
 	INITCALL(display_options);	/* say that we are here */
 	INITCALL(display_text_info);	/* show debugging info if required */
@@ -947,6 +949,7 @@
 #endif
 #if CONFIG_IS_ENABLED(DISPLAY_BOARDINFO)
 	INITCALL(show_board_info);
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "f_board_info");
 #endif
 	WATCHDOG_INIT();
 	INITCALL_EVT(EVT_MISC_INIT_F);
@@ -956,6 +959,7 @@
 #endif
 	INITCALL(announce_dram_init);
 	INITCALL(dram_init);		/* configure available RAM banks */
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "f_dram");
 #if CONFIG_IS_ENABLED(POST)
 	INITCALL(post_init_f);
 #endif
@@ -1025,6 +1029,7 @@
 	INITCALL(do_elf_reloc_fixups);
 #endif
 	INITCALL(clear_bss);
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "f_end");
 	/*
 	 * Deregister all cyclic functions before relocation, so that
 	 * gd->cyclic_list does not contain any references to pre-relocation
--- a/common/bootstage.c
+++ b/common/bootstage.c
@@ -478,7 +478,7 @@
 
 	/* Read the name strings */
 	ptr += rec_size;
-	for (rec = data->record + data->next_id, i = 0; i < hdr->count;
+	for (rec = data->record + data->rec_count, i = 0; i < hdr->count;
 	     i++, rec++) {
 		rec->name = ptr;
 		if (xpl_phase() == PHASE_SPL)
