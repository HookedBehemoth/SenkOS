diff --git a/src/clock.c b/src/clock.c
index e65f76a..35b64dc 100644
--- a/src/clock.c
+++ b/src/clock.c
@@ -47,6 +47,51 @@ void clocks_down(void)
 	       PRCM_PLL_LDO_REG);
 }
 
+/*
+ * Super standby, as the stock standby program does on top: AHB and the R_PRCM buses to the
+ * internal 16 MHz RC oscillator, the 24 MHz one left to the hardware's clock request, so it
+ * stops with VDD-SYS. Only R_I2C is used after this, for the PMIC.
+ */
+#define RTC_DCXO_CTRL_REG	(SUNXI_RTC_BASE + 0x160)
+#define DCXO_CLK_REQ_EN		BIT(31)
+#define DCXO_EN			BIT(1)
+#define RC16M_EN		BIT(0)
+#define CLK_SRC_RC16M		(0x2 << 24)
+#define CCU_PSI_AHB_CFG		0x510
+#define PRCM_CPUS_CFG_REG	(SUNXI_PRCM_BASE + 0x000)
+#define PRCM_APBS2_CFG_REG	(SUNXI_PRCM_BASE + 0x010)
+
+static struct {
+	u32 ahb;
+	u32 cpus;
+	u32 apbs2;
+	u32 dcxo;
+} saved_off;
+
+void clocks_off(void)
+{
+	saved_off.ahb = readl(CCU(CCU_PSI_AHB_CFG));
+	saved_off.cpus = readl(PRCM_CPUS_CFG_REG);
+	saved_off.apbs2 = readl(PRCM_APBS2_CFG_REG);
+	saved_off.dcxo = readl(RTC_DCXO_CTRL_REG);
+
+	setbits_le32(RTC_DCXO_CTRL_REG, RC16M_EN);
+	clrsetbits_le32(CCU(CCU_PSI_AHB_CFG), CLK_SRC_MASK, CLK_SRC_RC16M);
+	clrsetbits_le32(PRCM_CPUS_CFG_REG, CLK_SRC_MASK, CLK_SRC_RC16M);
+	clrsetbits_le32(PRCM_APBS2_CFG_REG, CLK_SRC_MASK, CLK_SRC_RC16M);
+	clrsetbits_le32(RTC_DCXO_CTRL_REG, DCXO_EN, DCXO_CLK_REQ_EN);
+}
+
+/* The power stayed on: the 24 MHz oscillator first, then what runs from it */
+void clocks_off_undo(void)
+{
+	writel(saved_off.dcxo, RTC_DCXO_CTRL_REG);
+	udelay(2000);
+	writel(saved_off.apbs2, PRCM_APBS2_CFG_REG);
+	writel(saved_off.cpus, PRCM_CPUS_CFG_REG);
+	writel(saved_off.ahb, CCU(CCU_PSI_AHB_CFG));
+}
+
 /* Everything back except the CPU clock, which stays on OSC24M during DRAM init */
 void clocks_up(void)
 {
diff --git a/src/main.c b/src/main.c
index 749ed01..29fa3b9 100644
--- a/src/main.c
+++ b/src/main.c
@@ -21,7 +21,12 @@
 #define SCR_IRQ_BIT		BIT(1)
 
 /* Memory the PHY training may overwrite, saved like the BSP does */
-#define SAVE_WORDS		0x50
+#define SAVE_WORDS		(SUNXI_SUSPEND_SAVE_BYTES / 4)
+
+#define AXP717_SLEEP_CFG	0x25
+#define AXP717_SLEEP_CFG_GO	0x6d	/* BL31's 0x2d plus auto sleep */
+
+#define RTC_HMS_REG		(SUNXI_RTC_BASE + 0x14)	/* time of day, from the 32 kHz clock */
 
 _Static_assert(offsetof(struct sunxi_suspend_params, resume_entry) == 0x10,
 	       "start.S expects resume_entry at offset 0x10");
@@ -84,6 +89,7 @@ static __attribute__((noreturn)) void resume_failed(void)
 static u32 save_lo[SAVE_WORDS];
 static u32 save_hi[SAVE_WORDS];
 static unsigned long save_hi_addr;
+static u32 dram_sum;
 
 static bool dram_suspend(const struct dram_config *config)
 {
@@ -91,6 +97,16 @@ static bool dram_suspend(const struct dram_config *config)
 
 	memcpy(save_lo, (void *)CFG_SYS_SDRAM_BASE, sizeof(save_lo));
 	memcpy(save_hi, (void *)save_hi_addr, sizeof(save_hi));
+	if (stub_params.poweroff) {
+		/* SRAM doesn't survive the power cut; SPL restores these from DRAM */
+		memcpy((void *)(unsigned long)stub_params.save_addr, save_lo, sizeof(save_lo));
+		memcpy((void *)(unsigned long)stub_params.save_addr + sizeof(save_lo), save_hi,
+		       sizeof(save_hi));
+		/* SPL checks it before returning to BL31, like the stock boot0's "dram crc" */
+		for (u32 *p = (u32 *)CFG_SYS_SDRAM_BASE;
+		     p < (u32 *)(CFG_SYS_SDRAM_BASE + SUNXI_SUSPEND_SUM_BYTES); p++)
+			dram_sum += *p;
+	}
 
 	return dram_enter_selfrefresh();
 }
@@ -111,6 +127,40 @@ static void dram_resume(const struct dram_config *config)
 	stage(STAGE_MEM_RESTORED);
 }
 
+/*
+ * Super standby: tell SPL how to come back, then let the PMIC cut VDD-CPU, VDD-SYS and VCC-IO
+ * (BL31 armed it). DRAM stays in self-refresh with its pads held in the RTC domain. Returns
+ * only if the power stays on; the caller then sleeps in WFI as usual. Runs with the clocks
+ * down: no UART.
+ */
+static void super_standby(void)
+{
+	bool sent;
+
+	writel((u32)stub_params.resume_entry, SUNXI_RTC_RESUME_ENTRY_REG);
+	writel(stub_params.save_addr, SUNXI_RTC_RESUME_SAVE_REG);
+	writel(stub_params.dram_cfg, SUNXI_RTC_RESUME_CFG_REG);
+	writel(dram_sum, SUNXI_RTC_RESUME_SUM_REG);
+	writel(SUNXI_RESUME_MAGIC, SUNXI_RTC_RESUME_MAGIC_REG);
+	stage(STAGE_POWEROFF);
+
+	clocks_off();
+	sent = pmic_write(AXP717_SLEEP_CFG, AXP717_SLEEP_CFG_GO);
+	/* The arch timer may stop with the 24 MHz oscillator: count RTC seconds */
+	for (u32 t = readl(RTC_HMS_REG), n = sent ? 3 : 0; n; ) {
+		u32 now = readl(RTC_HMS_REG);
+
+		if (now != t) {
+			t = now;
+			n--;
+		}
+	}
+	clocks_off_undo();
+
+	writel(0, SUNXI_RTC_RESUME_MAGIC_REG);
+	stage(STAGE_POWEROFF_FAILED);
+}
+
 void stub_main(void)
 {
 	struct dram_config config;
@@ -150,6 +200,8 @@ void stub_main(void)
 	dbg_puts("stub: DRAM in self-refresh\n");
 	stage(STAGE_CLOCKS_DOWN);
 	clocks_down();
+	if (stub_params.poweroff)
+		super_standby();
 
 	stage(STAGE_WFI);
 	wait_for_wakeup();
diff --git a/src/pmic.c b/src/pmic.c
new file mode 100644
index 0000000..37ac184
--- /dev/null
+++ b/src/pmic.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * One AXP717 register write over R_I2C, polled, for the super standby trigger. BL31 set the
+ * controller up (TF-A's mi2cv driver) just before; DRAM is in self-refresh by now, so BL31's
+ * code can't run.
+ */
+
+#include <asm/io.h>
+#include "stub.h"
+
+#define TWI(off)		(0x07081400 + (off))
+#define TWI_DATA		0x08
+#define TWI_CNTR		0x0c
+#define TWI_STAT		0x10
+
+#define CNTR_ACK		BIT(2)
+#define CNTR_IFLG		BIT(3)	/* sunxi: write 1 to clear */
+#define CNTR_STP		BIT(4)
+#define CNTR_STA		BIT(5)
+#define CNTR_BUS_EN		BIT(6)
+
+#define STAT_START		0x08
+#define STAT_ADDR_W_ACK		0x18
+#define STAT_DATA_W_ACK		0x28
+
+#define AXP717_ADDR		0x34
+
+static bool twi_step(u32 cntr, u32 status)
+{
+	writel(CNTR_BUS_EN | cntr, TWI(TWI_CNTR));
+	return wait_reg(TWI(TWI_CNTR), CNTR_IFLG, CNTR_IFLG, 10000) &&
+	       readl(TWI(TWI_STAT)) == status;
+}
+
+static bool twi_send(u8 byte, u32 status)
+{
+	writel(byte, TWI(TWI_DATA));
+	return twi_step(CNTR_IFLG, status);
+}
+
+bool pmic_write(u8 reg, u8 val)
+{
+	bool ok = twi_step(CNTR_STA, STAT_START) &&
+		  twi_send(AXP717_ADDR << 1, STAT_ADDR_W_ACK) &&
+		  twi_send(reg, STAT_DATA_W_ACK) &&
+		  twi_send(val, STAT_DATA_W_ACK);
+
+	writel(CNTR_BUS_EN | CNTR_STP | CNTR_IFLG, TWI(TWI_CNTR));
+	wait_reg(TWI(TWI_CNTR), CNTR_STP, 0, 10000);
+	return ok;
+}
