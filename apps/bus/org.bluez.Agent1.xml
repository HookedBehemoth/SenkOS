<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- What BlueZ asks while pairing (doc/org.bluez.Agent.rst); the launcher's -->
<node name="/org/senkos/Agent">
  <interface name="org.bluez.Agent1">
    <method name="Release"/>
    <method name="RequestPinCode"><arg name="device" type="o"/><arg name="pincode" type="s" direction="out"/></method>
    <method name="DisplayPinCode"><arg name="device" type="o"/><arg name="pincode" type="s"/></method>
    <method name="RequestPasskey"><arg name="device" type="o"/><arg name="passkey" type="u" direction="out"/></method>
    <method name="DisplayPasskey"><arg name="device" type="o"/><arg name="passkey" type="u"/><arg name="entered" type="q"/></method>
    <method name="RequestConfirmation"><arg name="device" type="o"/><arg name="passkey" type="u"/></method>
    <method name="RequestAuthorization"><arg name="device" type="o"/></method>
    <method name="AuthorizeService"><arg name="device" type="o"/><arg name="uuid" type="s"/></method>
    <method name="Cancel"/>
  </interface>
</node>
