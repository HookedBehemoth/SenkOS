<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- A network wpa_supplicant found (one access point of it), what the launcher uses of it -->
<node>
  <interface name="fi.w1.wpa_supplicant1.BSS">
    <annotation name="org.senkos.Service" value="fi.w1.wpa_supplicant1"/>
    <annotation name="org.senkos.Prefix" value="wpa_bss"/>
    <!-- Its name's bytes: empty or NULs when hidden -->
    <property name="SSID" type="ay" access="read"/>
    <!-- dBm -->
    <property name="Signal" type="n" access="read"/>
    <!-- Encrypted -->
    <property name="Privacy" type="b" access="read"/>
  </interface>
</node>
