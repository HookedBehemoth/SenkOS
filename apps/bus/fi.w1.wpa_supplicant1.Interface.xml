<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- wpa_supplicant's network interface (wlan0), what the launcher uses of it -->
<node>
  <interface name="fi.w1.wpa_supplicant1.Interface">
    <annotation name="org.senkos.Service" value="fi.w1.wpa_supplicant1"/>
    <annotation name="org.senkos.Prefix" value="wpa_iface"/>
    <method name="SelectNetwork"><arg name="network" type="o"/></method>
    <method name="RemoveNetwork"><arg name="network" type="o"/></method>
    <!-- The networks to the config file (update_config=1) -->
    <method name="SaveConfig"/>
    <method name="Reassociate"/>
    <!-- Forgets what it found longer than age seconds ago (0: all) -->
    <method name="FlushBSS"><arg name="age" type="u"/></method>
    <!-- disconnected, scanning, associating, 4way_handshake, completed, ... -->
    <property name="State" type="s" access="read"/>
    <property name="CurrentNetwork" type="o" access="read"/>
    <property name="CurrentBSS" type="o" access="read"/>
    <signal name="BSSAdded"><arg name="path" type="o"/><arg name="properties" type="a{sv}"/></signal>
    <signal name="BSSRemoved"><arg name="path" type="o"/></signal>
    <signal name="NetworkAdded"><arg name="path" type="o"/><arg name="properties" type="a{sv}"/></signal>
    <signal name="NetworkRemoved"><arg name="path" type="o"/></signal>
  </interface>
</node>
