<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- downloadd (root): system updates and the launcher's game packs, one job at a time. Callers:
     shell and root (apps/downloadd/org.senkos.Updates1.conf). A failure is an
     org.senkos.Updates1.Error.Failed saying why. -->
<node name="/org/senkos/Updates1">
  <interface name="org.senkos.Updates1">
    <!-- Is there a newer system? Answered once the server said; newer false: this is the latest -->
    <method name="Check">
      <arg name="newer" type="b" direction="out"/>
      <arg name="build" type="s" direction="out"/>
      <arg name="size" type="t" direction="out"/>
      <arg name="notes" type="s" direction="out"/>
    </method>
    <!-- The newer system into the other slot, armed for the next boot: job "os" -->
    <method name="Update"/>
    <!-- A launcher game pack, a .system file's Pack: job "pack:NAME", its spaces as '_' -->
    <method name="Pack"><arg name="name" type="s"/></method>
    <method name="Cancel"><arg name="id" type="s"/></method>
    <!-- Every job there is, as Job says them -->
    <method name="Jobs"><arg name="jobs" type="a(sstts)" direction="out"/></method>
    <!-- A job changed: state queued, downloading, installing, done, failed or canceled; done and
         total in bytes -->
    <signal name="Job">
      <arg name="id" type="s"/>
      <arg name="state" type="s"/>
      <arg name="done" type="t"/>
      <arg name="total" type="t"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
