#!/usr/bin/env python3
"""Publish to the store: ports and system images to Bunny's storage (S3, rclone), what they are to
the server's admin API, and what the store shows of a port (thumbnail, screenshots, readme) to the
server itself.

    tools/publish ports PORTDIR...      PortMaster-Decl's ports/<id>, with the layers they use
    tools/publish os [-m NOTES] [-c CHANNEL] [DEPLOYDIR]     the last build: slot and card image

Settings from the environment, else the repo's .env:
    PORTMASTER_ENDPOINT, PORTMASTER_BUCKET, PORTMASTER_PASSWORD     ports and layers
    OS_BUCKET, OS_PASSWORD                                          system images (same endpoint)
    STORE_ADMIN (the server, e.g. https://store.example), ADMIN_TOKEN

Files are named by their content's hash, so no cache ever serves an old copy under a new name.
A port is a .tar.zst of its folder (no top directory), what downloadd unpacks into apps/ports/<id>;
its thumbnail a WebP made from its cover or screenshot. Only the layers' aarch64 and armhf files
go up: the handheld runs nothing else.
"""
import argparse
import configparser
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEPLOY = Path('/mnt/multimedia/anbernic-yocto/build/tmp/deploy/images/rg35xx-sp')
ARCHES = ('aarch64', 'armhf')
IMAGES = ('cover', 'screenshot')


def settings():
    env = {}
    dotenv = REPO / '.env'
    if dotenv.exists():
        for line in dotenv.read_text().splitlines():
            key, eq, value = line.partition('=')
            if eq and not key.startswith('#'):
                env[key.strip()] = value.strip()
    env.update(os.environ)
    return env


ENV = settings()


def need(key):
    if not ENV.get(key):
        sys.exit(f'publish: {key} is not set (environment or .env)')
    return ENV[key]


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def upload(bucket, password, local, remote):
    """rclone, configured from the environment: the access key is the storage zone's name"""
    env = dict(os.environ,
               RCLONE_CONFIG_BUNNY_TYPE='s3', RCLONE_CONFIG_BUNNY_PROVIDER='Other',
               RCLONE_CONFIG_BUNNY_ENDPOINT=need('PORTMASTER_ENDPOINT'),
               RCLONE_CONFIG_BUNNY_ACCESS_KEY_ID=bucket, RCLONE_CONFIG_BUNNY_SECRET_ACCESS_KEY=password)
    subprocess.run(['rclone', '-q', 'copyto', '--s3-no-check-bucket', str(local), f'bunny:{bucket}/{remote}'],
                   env=env, check=True)


def admin(path, body, content_type='application/json'):
    data = body if isinstance(body, bytes) else json.dumps(body).encode()
    req = urllib.request.Request(need('STORE_ADMIN').rstrip('/') + path, method='PUT', data=data,
                                 headers={'Authorization': 'Bearer ' + need('ADMIN_TOKEN'),
                                          'Content-Type': content_type})
    with urllib.request.urlopen(req) as r:
        if r.status // 100 != 2:
            sys.exit(f'publish: {path}: {r.status}')


def port_ini(path):
    ini = configparser.ConfigParser(interpolation=None, strict=False, comment_prefixes=('#', ';'),
                                    inline_comment_prefixes=None)
    ini.optionxform = str
    ini.read(path)
    return ini['Port'] if ini.has_section('Port') else {}


def ports(dirs):
    bucket, password = need('PORTMASTER_BUCKET'), need('PORTMASTER_PASSWORD')

    def put(local, name):
        """Up under ports/<id>/<hash>-<name>; the path"""
        remote = f'{prefix}/{sha256(local)[:12]}-{name}'
        upload(bucket, password, local, remote)
        return remote

    def media(local, name):
        """To the server, as <hash>-<id>-<name>; the name"""
        named = f'{sha256(local)[:12]}-{pid}-{name}'
        admin(f'/admin/media/{named}', Path(local).read_bytes(), 'application/octet-stream')
        return named

    layers_done = set()
    for d in map(Path, dirs):
        d = d.resolve()
        pid = d.name
        p = port_ini(d / 'port.ini')
        if not p:
            sys.exit(f'publish: {d}: no [Port] in port.ini')
        prefix = f'ports/{pid}'
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            archive = tmp / f'{pid}.tar.zst'
            subprocess.run(f'tar -C "{d}" --sort=name --owner=0 --group=0 --numeric-owner -cf - . '
                           f'| zstd -q -19 -T0 -o "{archive}"', shell=True, check=True)
            installed = sum(f.stat().st_size for f in d.rglob('*') if f.is_file() and not f.is_symlink())
            shots = [f for n in IMAGES for f in sorted(d.glob(n + '.*'))
                     if f.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp')]
            thumb = ''
            if shots:
                t = tmp / 'thumb.webp'
                subprocess.run(['magick', str(shots[0]), '-thumbnail', '256x256>', '-quality', '82', str(t)],
                               check=True)
                thumb = media(t, 'thumb.webp')
            readme = media(d / 'port.md', 'port.md') if (d / 'port.md').exists() else ''
            body = {
                'name': p.get('Name', pid), 'porter': p.get('Porter', ''),
                'description': p.get('Description', ''), 'genres': p.get('Genres', ''),
                'arch': p.get('Arch', ''), 'layers': p.get('Layers', ''), 'needs': p.get('Needs', ''),
                'instructions': p.get('Instructions', ''),
                'archive': put(archive, f'{pid}.tar.zst'), 'sha256': sha256(archive),
                'size': archive.stat().st_size, 'installed_size': installed,
                'readme': readme, 'thumbnail': thumb,
                'screenshots': ''.join(media(s, s.name) + ';' for s in shots),
                'version': int(time.time()),
            }
        for layer in filter(None, (l.strip() for l in body['layers'].split(';'))):
            if layer in layers_done:
                continue
            layers_done.add(layer)
            ldir = d.parent.parent / 'layers'
            files = [ldir / f'{layer}.ini'] + [ldir / f'{layer}.{a}.squashfs' for a in ARCHES]
            for f in files:
                if f.exists():
                    remote = f'layers/{sha256(f)[:12]}-{f.name}'
                    upload(bucket, password, f, remote)
                    admin(f'/admin/layers/{f.name}', {'layer': layer, 'path': remote, 'sha256': sha256(f),
                                                     'size': f.stat().st_size})
        admin(f'/admin/ports/{pid}', body)
        print(f'{pid}: {body["size"] / 1e6:.1f} MB, version {body["version"]}')


def os_release(args):
    bucket, password = need('OS_BUCKET'), need('OS_PASSWORD')
    deploy = Path(args.deploy)
    slot = (deploy / 'senkos-image-rg35xx-sp.rootfs.squashfs-lz4').resolve()
    card = (deploy / 'senkos-image-rg35xx-sp.rootfs.wic.zst').resolve()
    bmap = (deploy / 'senkos-image-rg35xx-sp.rootfs.wic.bmap').resolve()
    build = subprocess.run(['unsquashfs', '-cat', str(slot), 'etc/build'], capture_output=True, text=True,
                           check=True).stdout.strip()
    if len(build) != 14 or not build.isdigit():
        sys.exit(f'publish: {slot}: no /etc/build')
    with tempfile.TemporaryDirectory() as tmp:
        z = Path(tmp) / 'slot.squashfs.zst'
        subprocess.run(['zstd', '-q', '-19', '-T0', str(slot), '-o', str(z)], check=True)
        upload(bucket, password, z, f'{build}/slot.squashfs.zst')
        upload(bucket, password, card, f'{build}/senkos-image.wic.zst')
        upload(bucket, password, bmap, f'{build}/senkos-image.wic.bmap')
        admin(f'/admin/releases/{build}', {
            'channel': args.channel, 'notes': args.notes,
            'slot': f'{build}/slot.squashfs.zst', 'slot_sha256': sha256(z), 'slot_size': z.stat().st_size,
            'image': f'{build}/senkos-image.wic.zst', 'image_sha256': sha256(card),
            'image_size': card.stat().st_size, 'created': int(time.time()),
        })
        print(f'{build}: slot {z.stat().st_size / 1e6:.0f} MB, card {card.stat().st_size / 1e6:.0f} MB')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='what', required=True)
    sub.add_parser('ports').add_argument('dirs', nargs='+')
    o = sub.add_parser('os')
    o.add_argument('-m', dest='notes', default='')
    o.add_argument('-c', dest='channel', default='stable')
    o.add_argument('deploy', nargs='?', default=str(DEPLOY))
    args = ap.parse_args()
    ports(args.dirs) if args.what == 'ports' else os_release(args)


if __name__ == '__main__':
    main()
