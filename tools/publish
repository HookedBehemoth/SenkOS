#!/usr/bin/env python3
"""Publish system images and the launcher's game packs: the files to the VPS's disk (rsync over ssh), which
Caddy serves under https://senkos.dev/files/, what they are to the server's admin API. The server sends
downloads there.

    tools/publish os [-m NOTES] [-c CHANNEL] [DEPLOYDIR]     the last build: slot and card image
    tools/publish packs PACK...         launcher game packs (tools/boxart-pack), "<Pack>.pack"

Settings from the environment, else the repo's .env:
    ADMIN_URL (the server's local/VPN admin listener)
    FILES (where the files go, rsync's form; vps@10.10.10.1:/home/vps/senkos/files by default)

A build's files are in a folder named by its build, a pack in one named by its hash: a path never
changes what it serves, so Caddy has them cached for good. A pack keeps its name, ready to copy.
"""
import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEPLOY = Path('/mnt/multimedia/anbernic-yocto/build/tmp/deploy/images/h700')


def settings():
    env = {}
    dotenv = REPO / '.env'
    if dotenv.exists():
        for line in dotenv.read_text().splitlines():
            key, eq, value = line.partition('=')
            if eq and not key.startswith('#'):
                env[key.strip()] = value.strip()
    env.update(os.environ)
    return env


ENV = settings()


def need(key):
    if not ENV.get(key):
        sys.exit(f'publish: {key} is not set (environment or .env)')
    return ENV[key]


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def upload(local, remote):
    """rsync: written aside, renamed into place, so a half-sent file is never served"""
    subprocess.run(['rsync', '-q', '--chmod=D755,F644', '--mkpath', str(local),
                    ENV.get('FILES', 'vps@10.10.10.1:/home/vps/senkos/files').rstrip('/') + '/' + remote], check=True)


def admin(path, body=None, content_type='application/json', method='PUT'):
    data = None if body is None else body if isinstance(body, bytes) else json.dumps(body).encode()
    req = urllib.request.Request(need('ADMIN_URL').rstrip('/') + path, method=method, data=data,
                                 headers={'Content-Type': content_type})
    with urllib.request.urlopen(req) as r:
        return json.load(r) if method == 'GET' else None


def os_release(args):
    deploy = Path(args.deploy)
    slot = (deploy / 'senkos-image-h700.rootfs.squashfs-lz4').resolve()
    card = (deploy / 'senkos-image-h700.rootfs.wic.gz').resolve()
    bmap = (deploy / 'senkos-image-h700.rootfs.wic.bmap').resolve()
    build = subprocess.run(['unsquashfs', '-cat', str(slot), 'etc/build'], capture_output=True, text=True,
                           check=True).stdout.strip()
    if len(build) != 14 or not build.isdigit():
        sys.exit(f'publish: {slot}: no /etc/build')
    with tempfile.TemporaryDirectory() as tmp:
        z = Path(tmp) / 'slot.squashfs.zst'
        subprocess.run(['zstd', '-q', '-19', '-T0', str(slot), '-o', str(z)], check=True)
        upload(z, f'{build}/slot.squashfs.zst')
        upload(card, f'{build}/senkos-image.wic.gz')
        upload(bmap, f'{build}/senkos-image.wic.bmap')
        admin(f'/admin/releases/{build}', {
            'channel': args.channel, 'notes': args.notes,
            'slot': f'{build}/slot.squashfs.zst', 'slot_sha256': sha256(z), 'slot_size': z.stat().st_size,
            'image': f'{build}/senkos-image.wic.gz', 'image_sha256': sha256(card),
            'image_size': card.stat().st_size, 'created': int(time.time()),
        })
        print(f'{build}: slot {z.stat().st_size / 1e6:.0f} MB, card {card.stat().st_size / 1e6:.0f} MB')


def packs(files):
    for f in map(Path, files):
        h = sha256(f)
        remote = f'thumbnails/{h[:12]}/{f.name}'
        upload(f, remote)
        admin('/admin/packs/' + urllib.parse.quote(f.stem),
              {'path': urllib.parse.quote(remote), 'sha256': h, 'size': f.stat().st_size})
        print(f'{f.stem}: {f.stat().st_size / 1e6:.1f} MB')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='what', required=True)
    o = sub.add_parser('os')
    o.add_argument('-m', dest='notes', default='')
    o.add_argument('-c', dest='channel', default='stable')
    o.add_argument('deploy', nargs='?', default=str(DEPLOY))
    sub.add_parser('packs').add_argument('files', nargs='+')
    args = ap.parse_args()
    if args.what == 'packs':
        packs(args.files)
    else:
        os_release(args)


if __name__ == '__main__':
    main()
