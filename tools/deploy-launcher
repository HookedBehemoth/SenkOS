#!/bin/sh
# Build launcher/ for the handheld and swap it in as /data/bin/launcher over USB. weston.init
# restarts the launcher when it exits, so killing the old one is the whole restart.
# No /data/bin/launcher: the image's /usr/bin/launcher runs (`tools/ssh rm /data/bin/launcher`).
set -e
cd "$(dirname "$0")"
# kas-container takes its work dir from the cwd
(cd ../yocto && ./kas build --target launcher rg35xx-sp.yml)
bin=${ANBERNIC_BUILD_ROOT:-/mnt/multimedia/anbernic-yocto}/build/tmp/deploy/images/rg35xx-sp/launcher
./ssh 'mkdir -p /data/bin && cat > /data/bin/launcher.new && chmod 755 /data/bin/launcher.new &&
	mv /data/bin/launcher.new /data/bin/launcher && killall launcher' < "$bin"
