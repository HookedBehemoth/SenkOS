#!/bin/sh
# Build launcher/ for the handheld and swap it in as /data/OS/launcher over USB. weston.init
# restarts the launcher when it exits, so killing the old one is the whole restart.
# No /data/OS/launcher: the image's /usr/bin/launcher runs (`tools/ssh rm /data/OS/launcher`).
set -e
cd "$(dirname "$0")"
# kas-container takes its work dir from the cwd
(cd ../yocto && ./kas build --target launcher rg35xx-sp.yml)
bin=${ANBERNIC_BUILD_ROOT:-/mnt/multimedia/anbernic-yocto}/build/tmp/deploy/images/rg35xx-sp/launcher
# Copied, then checked: an interrupted copy leaves a short file that `cat` doesn't fail on
size=$(wc -c < "$bin")
timeout 60 ./ssh 'mkdir -p /data/OS && cat > /data/OS/launcher.new' < "$bin"
timeout 20 ./ssh "[ \$(wc -c < /data/OS/launcher.new) = $size ] && chmod 755 /data/OS/launcher.new &&
	mv /data/OS/launcher.new /data/OS/launcher && killall launcher"
