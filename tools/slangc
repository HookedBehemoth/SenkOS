#!/usr/bin/env python3
# libretro slang shader presets, compiled for corehost (recipes-emulators/libretro-shaders, and
# by hand for shaders to put in /data/OS/assets/shaders): each preset and the textures it names
# are copied as they are, at the same path under OUT, and every .slang it uses becomes
#     X.slang.vert.spv, X.slang.frag.spv     (SPIR-V, glslangValidator; names kept: corehost
#                                             finds the semantics by them)
#     X.slang.meta                           (the pragmas: name=, format=, and a
#                                             [parameter NAME] section each: desc, default,
#                                             min, max, step)
# The source is preprocessed as RetroArch does (slang_process.cpp): #include resolved, what
# comes before the first "#pragma stage" in both stages, then each stage its own part.
#     tools/slangc SRC OUT PRESET.slangp...      (presets relative to SRC)
import os
import re
import shutil
import subprocess
import sys
import tempfile


def read_preset(path):
    """key = value lines, quotes dropped; # comments"""
    values = {}
    for line in open(path, encoding='utf-8', errors='replace'):
        line = line.strip()
        if line.startswith('#reference'):
            sys.exit('slangc: %s: #reference presets are not supported' % path)
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, value = line.split('=', 1)
        values[key.strip()] = value.strip().strip('"')
    return values


def source(path, seen):
    """The file with its #includes in place"""
    out = []
    for line in open(path, encoding='utf-8', errors='replace'):
        m = re.match(r'\s*#include\s+"([^"]+)"', line)
        if m:
            inc = os.path.normpath(os.path.join(os.path.dirname(path), m.group(1)))
            if inc not in seen:
                seen.add(inc)
                out += source(inc, seen)
            continue
        out.append(line.rstrip('\n'))
    return out


def compile_slang(src, out):
    lines = source(src, {src})
    stages = {'vertex': [], 'fragment': []}
    meta = {'name': None, 'format': None}
    params = {}
    stage = None
    for line in lines:
        m = re.match(r'\s*#pragma\s+(\w+)\s*(.*)', line)
        if m and m.group(1) == 'stage':
            stage = m.group(2).strip()
            continue
        if m and m.group(1) in ('name', 'format'):
            meta[m.group(1)] = m.group(2).strip()
            continue
        if m and m.group(1) == 'parameter':
            p = re.match(r'(\w+)\s+"([^"]*)"\s+(\S+)\s+(\S+)\s+(\S+)\s*(\S+)?', m.group(2))
            if p and p.group(1) not in params:
                params[p.group(1)] = p.groups()[1:]
            continue
        for s in ([stage] if stage else stages):
            stages[s].append(line)
    for s, ext in (('vertex', 'vert'), ('fragment', 'frag')):
        with tempfile.NamedTemporaryFile('w', suffix='.' + ext, delete=False) as f:
            f.write('\n'.join(stages[s]) + '\n')
        try:
            r = subprocess.run(['glslangValidator', '-V', '--target-env', 'vulkan1.0', '-o',
                                '%s.%s.spv' % (out, ext), f.name], capture_output=True, text=True)
        finally:
            os.unlink(f.name)
        if r.returncode != 0:
            sys.exit('slangc: %s (%s):\n%s' % (src, s, r.stdout + r.stderr))
    with open(out + '.meta', 'w') as f:
        for key in ('name', 'format'):
            if meta[key]:
                f.write('%s=%s\n' % (key, meta[key]))
        for name, (desc, default, lo, hi, step) in params.items():
            f.write('\n[parameter %s]\ndesc=%s\ndefault=%s\nmin=%s\nmax=%s\nstep=%s\n'
                    % (name, desc, default, lo, hi, step or '0'))


def main():
    if len(sys.argv) < 4:
        sys.exit('usage: slangc SRC OUT PRESET.slangp...')
    src, out = sys.argv[1], sys.argv[2]
    done = set()
    for preset in sys.argv[3:]:
        values = read_preset(os.path.join(src, preset))
        here = os.path.dirname(preset)
        files = [values['shader%d' % i] for i in range(int(values.get('shaders', 0)))]
        textures = [values[t] for t in values.get('textures', '').split(';') if t]
        os.makedirs(os.path.join(out, here), exist_ok=True)
        shutil.copyfile(os.path.join(src, preset), os.path.join(out, preset))
        for rel in files + textures:
            path = os.path.normpath(os.path.join(here, rel))
            if path in done:
                continue
            done.add(path)
            os.makedirs(os.path.join(out, os.path.dirname(path)), exist_ok=True)
            if rel.endswith('.slang'):
                compile_slang(os.path.join(src, path), os.path.join(out, path))
            else:
                shutil.copyfile(os.path.join(src, path), os.path.join(out, path))


main()
