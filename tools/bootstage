#!/usr/bin/env python3
# Print the handheld's U-Boot bootstage records (needs a bootloader built with UBOOT_BOOTSTAGE = "1":
# add it to local_conf_header in yocto/h700.yml, `./kas build --target u-boot`, flash it).
# Times are from SoC reset. SPL's first mark comes after DRAM init: SPL has no heap before that.
import os, struct, subprocess, sys, tarfile

ssh = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'ssh')
tar = subprocess.run([ssh, 'tar cf - -C /sys/firmware/devicetree/base bootstage'],
                     stdin=subprocess.DEVNULL, capture_output=True, check=True).stdout
if not tar:
    sys.exit('no /sys/firmware/devicetree/base/bootstage: bootloader built without UBOOT_BOOTSTAGE?')

nodes = {}
with tarfile.open(fileobj=__import__('io').BytesIO(tar)) as t:
    for m in t:
        parts = m.name.split('/')
        if m.isfile() and len(parts) >= 2:
            nodes.setdefault(parts[-2], {})[parts[-1]] = t.extractfile(m).read()

marks, accums = [], []
for n in nodes.values():
    name = n.get('name', b'?').rstrip(b'\0').decode()
    if 'mark' in n:
        marks.append((struct.unpack('>I', n['mark'][-4:])[0], name))
    elif 'accum' in n:
        accums.append((struct.unpack('>I', n['accum'][-4:])[0], name))
prev = 0
print(f"{'since reset':>12} {'step':>9}  mark")
for us, name in sorted(marks):
    print(f"{us / 1000:10.1f}ms {(us - prev) / 1000:7.1f}ms  {name}")
    prev = us
for us, name in accums:
    print(f"  accumulated {us / 1000:7.1f}ms  {name}")
