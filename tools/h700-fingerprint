#!/bin/sh
# Prints what tells H700 handhelds (and their panel revisions) apart, for picking the dtb at boot.
# Read-only, POSIX sh, no extra tools: runs as root on ROCKNIX, Knulli, muOS or ours.
# Usage: sh h700-fingerprint > fingerprint.txt

s() { echo; echo "## $1"; }
cat_all() { for f in "$@"; do [ -r "$f" ] && echo "$f: $(tr '\0' ' ' < "$f")"; done; }

s "dt"
cat_all /proc/device-tree/model /proc/device-tree/compatible /proc/device-tree/rocknix-dt-id

s "panel id"
dmesg | grep -i "display id"

s "memory"
grep MemTotal /proc/meminfo

s "drm modes"
for c in /sys/class/drm/card*-*; do [ -r "$c/modes" ] && echo "${c##*/}: $(cat "$c/status") $(tr '\n' ' ' < "$c/modes")"; done

s "i2c"
for d in /sys/bus/i2c/devices/*; do [ -r "$d/name" ] && echo "${d##*/}: $(cat "$d/name")"; done

s "sdio"
for d in /sys/bus/sdio/devices/*; do [ -r "$d/vendor" ] && echo "${d##*/}: $(cat "$d/vendor"):$(cat "$d/device")"; done

s "input"
grep -E "^N:" /proc/bus/input/devices

s "iio"
for d in /sys/bus/iio/devices/iio:device*; do
	[ -d "$d" ] || continue
	echo "${d##*/}: $(cat "$d/name" 2>/dev/null)"
	for r in "$d"/in_*_raw; do [ -r "$r" ] && echo "  ${r##*/} = $(cat "$r")"; done
done

# Stock boot0 picks its DRAM parameter set from straps on PH6/7/8/10 (pulled up; all high = LPDDR4 on the SP).
# Sampled with pull-up and pull-down, only while the pins are unused (function 7), then restored.
s "dram straps"
if command -v devmem >/dev/null; then
	C0=0x0300B0FC C1=0x0300B100 D=0x0300B10C P=0x0300B118
	c0=$(devmem $C0 32) c1=$(devmem $C1 32) p=$(devmem $P 32)
	if [ $(( c0 >> 24 )) = $(( 0x77 )) ] && [ $(( c1 & 0xF0F )) = $(( 0x707 )) ]; then
		devmem $C0 32 $(( c0 & 0x00FFFFFF )); devmem $C1 32 $(( c1 & ~0xF0F ))
		devmem $P 32 $(( (p & ~0x33F000) | 0x115000 )); sleep 1; u=$(devmem $D 32)
		devmem $P 32 $(( (p & ~0x33F000) | 0x22A000 )); sleep 1; d=$(devmem $D 32)
		devmem $C0 32 $c0; devmem $C1 32 $c1; devmem $P 32 $p
		for n in 6 7 8 10; do echo "PH$n pullup=$(( (u >> n) & 1 )) pulldown=$(( (d >> n) & 1 ))"; done
	else
		echo "PH6-10 in use: $c0 $c1"
	fi
else
	echo "no devmem"
fi

# Stock U-Boot picks the SP panel from PE6: high = original (FOG) panel, low = BOE ("v2") panel.
s "panel strap"
if command -v devmem >/dev/null; then
	C0=0x0300B090 D=0x0300B0A0 P=0x0300B0AC
	c0=$(devmem $C0 32) p=$(devmem $P 32)
	if [ $(( (c0 >> 24) & 0xF )) = 7 ]; then
		devmem $C0 32 $(( c0 & ~0x0F000000 ))
		devmem $P 32 $(( (p & ~0x3000) | 0x1000 )); sleep 1; u=$(devmem $D 32)
		devmem $P 32 $(( (p & ~0x3000) | 0x2000 )); sleep 1; d=$(devmem $D 32)
		devmem $C0 32 $c0; devmem $P 32 $p
		echo "PE6 pullup=$(( (u >> 6) & 1 )) pulldown=$(( (d >> 6) & 1 ))"
	else
		echo "PE6 in use: $c0"
	fi
else
	echo "no devmem"
fi

s "gpio"
[ -r /sys/kernel/debug/gpio ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
cat /sys/kernel/debug/gpio 2>/dev/null || echo "no debugfs"
